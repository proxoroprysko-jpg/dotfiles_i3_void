# ============================================================================
# МИНИМАЛИСТИЧНЫЙ КОНФИГ I3 ДЛЯ VOID LINUX (MINIMAL BLUE/GRAY STYLE)
# ============================================================================

# Модификатор (клавиша Super / Win)
set $mod Mod4

# Шрифты для заголовков окон
font pango:JetBrainsMono Nerd Font 10

# Тонкие рамки для окон, чтобы соответствовать обоям
new_window pixel 2
new_float pixel 2
hide_edge_borders none

# ============================================================================
# ЦВЕТОВАЯ ПАЛИТРА (VOID MINIMAL VECTOR STYLE)
# ============================================================================
# Класс                 Граница  Фон     Текст   Индикатор Ребенок
client.focused          #d1d7e0 #29313a #ffffff #d1d7e0   #d1d7e0
client.focused_inactive #3b4552 #29313a #8a95a5 #3b4552   #3b4552
client.unfocused        #29313a #29313a #8a95a5 #29313a   #29313a
client.urgent           #fb4934 #29313a #fb4934 #fb4934   #fb4934
client.placeholder      #29313a #29313a #ffffff #29313a   #29313a
client.background       #29313a

# ============================================================================
# АВТОЗАПУСК И ГЛОБАЛЬНАЯ ТЕМНАЯ ТЕМА
# ============================================================================
# Настройки GTK темной темы для системных утилит
exec_always --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
exec_always --no-startup-id gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# Запуск панели Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Запуск композитного менеджера Picom (эффекты и прозрачность)
exec --no-startup-id picom -b

exec --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle,grp_led:caps

# Установка новых обоев (измени путь, если положил картинку в другое место)
exec --no-startup-id feh --bg-scale ~/Загрузки/gojira.png

# ============================================================================
# ОСНОВНЫЕ ГОРЯЧИЕ КЛАВИШИ
# ============================================================================

# Запуск терминала Kitty на Super+q
bindsym $mod+q exec kitty

# Закрыть окно (на Super+x и Super+c)
bindsym $mod+x kill
bindsym $mod+c kill

# Запуск меню приложений
bindsym $mod+r exec --no-startup-id rofi -show drun

# Создание скриншота через Flameshot (выделение области)
bindsym Shift+Print exec flameshot gui

# Запуск программы записи экрана vokoscreenNG
bindsym $mod+p exec vokoscreenNG

# Изменение фокуса (как в vim: h j k l или стрелочки)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Перемещение окон
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Разделение окон (горизонтальное / вертикальное)
bindsym $mod+b split h
bindsym $mod+v split v

# Полноэкранный режим
bindsym $mod+f fullscreen toggle

# Переключение стилей контейнеров (плиточный / стек / вкладки)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Переключение режима плавающего окна
bindsym $mod+Shift+space floating toggle

# Переключение фокуса между плиткой и плавающим окном
bindsym $mod+space focus mode_toggle

# Управление мультимедиа
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# ============================================================================
# ВОРКСПЕЙСЫ (РАБОЧИЕ СТОЛЫ)
# ============================================================================
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

# Переключение на воркспейс
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

# Перенос окна на другой воркспейс
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# ============================================================================
# СИСТЕМНЫЕ ОПЕРАЦИИ
# ============================================================================

# Перезагрузка конфигурации i3
bindsym $mod+Shift+c reload
# Полный перезапуск i3 в оперативной памяти
bindsym $mod+Shift+r restart
# Выход из i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Выйти из i3?' -B 'Да' 'i3-msg exit'"

# ============================================================================
# РЕЖИМ РЕСАЙЗА (ИЗМЕНЕНИЕ РАЗМЕРОВ ОКОН)
# ============================================================================
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
}
